# Copy to .env and fill in. Never commit .env.
DATA_GOV_IN_API_KEY=
# Resource id(s) confirmed by scripts/probe_sources.py
AGMARKNET_CURRENT_RESOURCE_ID=
AGMARKNET_HISTORY_RESOURCE_ID=
# Max requests per second to api.data.gov.in (conservative until measured)
AGMARKNET_MAX_RPS=1
# Rows per API call. Measured 2026-11-17 from Mumbai: time grows ~linearly with size
# (~1.05 s per 1000 rows), so bigger pages mostly mean fewer calls, not much speed.
AGMARKNET_PAGE_SIZE=5000

# Airflow 3: all components sign task tokens with this. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-locally
S3_ENDPOINT=http://minio:9000
LAKE_BUCKET=lake

# Only used by scripts/suggest_variety_mappings.py (human-in-the-loop); the pipeline never calls an LLM.
ANTHROPIC_API_KEY=

# Optional BigQuery dbt target
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# data.gov.in is geo-blocked outside India (confirmed 2026-11-12).
# From the US, route API calls through an India-region host, e.g. `ssh -N -D 1080 user@<india-vm>`:
# e.g. socks5h://127.0.0.1:1080 ; leave empty when running from India
AGMARKNET_PROXY=
